# =============================================================
#  Universal .gitignore for hardware projects
#  (Blender, KiCad, FreeCAD, Creo, PlatformIO / Arduino, VS Code)
# =============================================================

# ---------- Logs & tool output ----------
*.log
std.out
*.out
trail.txt
trail.txt.*

# ---------- Generic backups / temp / autosave ----------
*.bak
*.backup
*.tmp
*.temp
*~
*.swp
*.swo
*.orig

# ---------- Blender ----------
# Auto-backups created on every save (.blend1, .blend2 ...)
*.blend[0-9]
*.blend[0-9][0-9]
# Crash recovery / autosave
quit.blend
*_autosave.blend

# ---------- KiCad ----------
# Per-user local settings (layer visibility, open panels) — incl. stray temp ones like The4449.kicad_prl
*.kicad_prl
# Auto backups
*-backups/
_restore_backup_*/
*-bak
*.kicad_sch-bak
*.kicad_pcb-bak
*.sch-bak
# Autosave / lock files
_autosave-*
\#auto_saved_files\#
~*.lck
*.lck
# Footprint cache
fp-info-cache
*.cache
# Old-style KiCad symbol/library backup + cache
*-cache.lib
*-rescue.lib
*-rescue.dcm

# ---------- FreeCAD ----------
*.FCBak
*.FCStd1
*.FCStd2

# ---------- Creo / Pro-Engineer ----------
# Error log + session trail. (Numbered .prt.N / .asm.N files are the
# real models in Creo, so they are NOT ignored here.)
mc_err.log
*.crc
*.inf
*.m_p
*.memb
*.lst

# ---------- PlatformIO / Arduino firmware ----------
.pio/
.pioenvs/
.piolibdeps/
build/
*.elf
*.hex
*.bin
*.map

# ---------- VS Code (keep extensions.json, settings.json) ----------
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# ---------- OS junk ----------
.DS_Store
._*
__MACOSX/
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
